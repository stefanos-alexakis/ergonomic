generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Plataforma / tenancy ────────────────────────────────────────────────

model Workspace {
  id            String    @id @default(cuid())
  nome          String
  slug          String    @unique
  logoUrl       String?
  corPrimaria   String? // hex "#RRGGBB"; nulo = tema cinza padrão
  corSecundaria String?
  timezone      String    @default("America/Sao_Paulo")
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  memberships   Membership[]
  setores       SetorOrg[]
  departamentos Departamento[]
  segmentos     Segmento[]
  funcoes       Funcao[]
  pesquisas     Pesquisa[]
  avaliacoesEixo2 AvaliacaoEixo2[]
  levantamentosEixo3 LevantamentoEixo3[]

  @@index([slug])
}

model User {
  id              String   @id @default(cuid())
  nome            String
  email           String   @unique
  passwordHash    String
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())

  memberships Membership[]
}

enum MembershipRole {
  GESTOR
  VIEWER
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  workspaceId String
  role        MembershipRole @default(GESTOR)
  // true = vínculo temporário criado quando um admin da plataforma
  // "assume" a visão de gestor de uma empresa (src/lib/impersonacao.ts) —
  // nunca um vínculo real de gestor. Permite limpar exatamente essas
  // linhas sem tocar nas de verdade.
  impersonada Boolean        @default(false)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ── Catálogo global do questionário ─────────────────────────────────────

model Questionario {
  id        String   @id @default(cuid())
  nome      String
  versao    Int      @default(1)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  blocos          Bloco[]
  pesquisas       Pesquisa[]
  avaliacoesEixo2 AvaliacaoEixo2[]
}

model Bloco {
  id             String @id @default(cuid())
  questionarioId String
  nome           String
  ordem          Int

  questionario Questionario @relation(fields: [questionarioId], references: [id], onDelete: Cascade)
  dimensoes    Dimensao[]

  @@index([questionarioId])
}

model Dimensao {
  id      String @id @default(cuid())
  blocoId String
  nome    String
  ordem   Int

  bloco        Bloco        @relation(fields: [blocoId], references: [id], onDelete: Cascade)
  fatoresRisco FatorRisco[]

  @@index([blocoId])
}

model FatorRisco {
  id         String @id @default(cuid())
  dimensaoId String
  nome       String

  dimensao  Dimensao   @relation(fields: [dimensaoId], references: [id], onDelete: Cascade)
  perguntas Pergunta[]

  @@index([dimensaoId])
}

enum Polaridade {
  MAIOR_PIOR
  MAIOR_MELHOR
}

model Pergunta {
  id                  String     @id @default(cuid())
  fatorRiscoId        String
  situacaoInvestigada String
  texto               String
  // Explicação opcional mostrada abaixo da pergunta ("Exemplo: ..."),
  // introduzida no questionário v2 (revisão da cliente, set/2026).
  exemplo             String?
  ordemGlobal         Int
  polaridade          Polaridade @default(MAIOR_PIOR)
  // Peso no cálculo do Score Base (Eixo 1) — 1 = peso normal, todas as
  // perguntas nascem iguais. Editável pela Hozana na área administrativa;
  // o dashboard recalcula ao vivo com o peso vigente (não é congelado por
  // pesquisa — ver review.md sobre a decisão do usuário).
  peso                Float      @default(1)

  fatorRisco    FatorRisco     @relation(fields: [fatorRiscoId], references: [id], onDelete: Cascade)
  respostaItens RespostaItem[]
  questaoEixo2  QuestaoEixo2?
  matrizCid     MatrizCidSituacao?

  @@index([fatorRiscoId])
  @@index([ordemGlobal])
}

// ── Estrutura organizacional (por empresa) ──────────────────────────────

model SetorOrg {
  id          String @id @default(cuid())
  workspaceId String
  nome        String
  // Quantas pessoas trabalham no setor — opcional; habilita "% de
  // participação" (Eixo 1) e taxa de ocorrências (Eixo 3) no painel final.
  numeroColaboradores Int?

  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  respostas       Resposta[]
  avaliacoesEixo2 AvaliacaoEixo2Setor[]
  respostasEixo2  RespostaEixo2[]
  ocorrenciasEixo3 OcorrenciaEixo3[]

  @@unique([workspaceId, nome])
  @@index([workspaceId])
}

model Departamento {
  id          String @id @default(cuid())
  workspaceId String
  nome        String

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  respostas Resposta[]

  @@unique([workspaceId, nome])
  @@index([workspaceId])
}

model Segmento {
  id          String @id @default(cuid())
  workspaceId String
  nome        String

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  respostas Resposta[]

  @@unique([workspaceId, nome])
  @@index([workspaceId])
}

model Funcao {
  id          String @id @default(cuid())
  workspaceId String
  nome        String

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  respostas Resposta[]

  @@unique([workspaceId, nome])
  @@index([workspaceId])
}

// ── Pesquisa, licenças e respostas ───────────────────────────────────────

enum PesquisaStatus {
  RASCUNHO
  AGENDADA
  ABERTA
  ENCERRADA
}

model Pesquisa {
  id                   String         @id @default(cuid())
  workspaceId          String
  questionarioId       String
  nome                 String
  slug                 String
  status               PesquisaStatus @default(RASCUNHO)
  dataInicio           DateTime
  dataFim              DateTime
  licencasSolicitadas  Int
  limiteSupressaoGrupo Int            @default(5)
  createdAt            DateTime       @default(now())

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  questionario Questionario   @relation(fields: [questionarioId], references: [id])
  codigos      CodigoAcesso[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

enum CodigoTipo {
  PARTICIPANTE
  TESTE
}

enum CodigoStatus {
  DISPONIVEL
  INICIADO
  CONCLUIDO
  EXPIRADO
  BLOQUEADO
}

model CodigoAcesso {
  id         String       @id @default(cuid())
  pesquisaId String
  codigo     String       @unique
  tipo       CodigoTipo
  status     CodigoStatus @default(DISPONIVEL)
  createdAt  DateTime     @default(now())

  pesquisa Pesquisa  @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  resposta Resposta?

  @@index([pesquisaId])
  @@index([status])
}

model Resposta {
  id             String    @id @default(cuid())
  codigoAcessoId String    @unique
  setorId        String?
  departamentoId String?
  segmentoId     String?
  funcaoId       String?
  iniciadoEm     DateTime  @default(now())
  concluidoEm    DateTime?

  codigoAcesso CodigoAcesso   @relation(fields: [codigoAcessoId], references: [id], onDelete: Cascade)
  setor        SetorOrg?      @relation(fields: [setorId], references: [id])
  departamento Departamento?  @relation(fields: [departamentoId], references: [id])
  segmento     Segmento?      @relation(fields: [segmentoId], references: [id])
  funcao       Funcao?        @relation(fields: [funcaoId], references: [id])
  itens        RespostaItem[]

  @@index([setorId])
  @@index([departamentoId])
  @@index([segmentoId])
  @@index([funcaoId])
}

model RespostaItem {
  id           String   @id @default(cuid())
  respostaId   String
  perguntaId   String
  valor        Int
  respondidoEm DateTime @default(now())

  resposta Resposta @relation(fields: [respostaId], references: [id], onDelete: Cascade)
  pergunta Pergunta @relation(fields: [perguntaId], references: [id])

  @@unique([respostaId, perguntaId])
  @@index([perguntaId])
}

// ── Eixo 2 — medidas de controle, respondido pela empresa por setor ──────
//
// Cada questão do Eixo 2 é a contrapartida, do lado da empresa, de uma
// pergunta do Eixo 1 (1:1) — herda dela dimensão e fator, que é a unidade
// em que a metodologia calcula o fator de correção (0,80/0,90/1,00).

enum CondicaoMedida {
  EFICAZ           // medida existente e eficaz — 0,80
  PRECISA_MELHORAR // existente, mas precisa melhorar — 0,90
  INEXISTENTE      // medida inexistente — 1,00
  NAO_SE_APLICA    // não exposto à situação — 0,80 (mesmo valor de EFICAZ)
}

enum StatusAvaliacao {
  RASCUNHO
  CONCLUIDA
}

model QuestaoEixo2 {
  id              String  @id @default(cuid())
  perguntaEixo1Id String  @unique
  texto           String
  // Texto colado (editável) quando o usuário habilita o plano de ação.
  planoSugerido   String?
  ordem           Int
  // Peso no fator do Eixo 2 — configurável pelo admin, como no Eixo 1.
  peso            Float   @default(1)

  perguntaEixo1 Pergunta        @relation(fields: [perguntaEixo1Id], references: [id], onDelete: Cascade)
  respostas     RespostaEixo2[]

  @@index([ordem])
}

// Ciclo de avaliação da empresa — independente das pesquisas do Eixo 1
// (decisão do usuário); o cruzamento é escolhido depois, no painel final.
model AvaliacaoEixo2 {
  id              String          @id @default(cuid())
  workspaceId     String
  // Versão do Eixo 1 cujo catálogo do Eixo 2 esta avaliação usa.
  questionarioId  String
  nome            String
  status          StatusAvaliacao @default(RASCUNHO)
  participantes   String?
  responsavel     String?
  observacaoFinal String?
  createdAt       DateTime        @default(now())
  concluidaEm     DateTime?

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  questionario Questionario          @relation(fields: [questionarioId], references: [id])
  setores      AvaliacaoEixo2Setor[]
  respostas    RespostaEixo2[]
  praticas     PraticaAdicional[]

  @@index([workspaceId])
}

model AvaliacaoEixo2Setor {
  avaliacaoId String
  setorId     String

  avaliacao AvaliacaoEixo2 @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  // Apagar um setor do cadastro tira ele (e suas respostas) da avaliação.
  setor     SetorOrg       @relation(fields: [setorId], references: [id], onDelete: Cascade)

  @@id([avaliacaoId, setorId])
  @@index([setorId])
}

// Uma linha por setor, sempre. "Mesma resposta para todos os setores" é um
// modo da tela que grava a mesma resposta em todos — não um campo aqui.
model RespostaEixo2 {
  id            String         @id @default(cuid())
  avaliacaoId   String
  questaoId     String
  setorId       String
  condicao      CondicaoMedida
  justificativa String?
  planoAcao     String?
  updatedAt     DateTime       @updatedAt

  avaliacao AvaliacaoEixo2 @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  questao   QuestaoEixo2   @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  setor     SetorOrg       @relation(fields: [setorId], references: [id], onDelete: Cascade)

  @@unique([avaliacaoId, questaoId, setorId])
  @@index([setorId])
}

// "Práticas adicionais declaradas pela empresa" do instrumento do Eixo 2.
model PraticaAdicional {
  id          String  @id @default(cuid())
  avaliacaoId String
  descricao   String
  frequencia  String?
  evidencia   String?
  ordem       Int

  avaliacao AvaliacaoEixo2 @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@index([avaliacaoId])
}

// ── Eixo 3 — ocorrências CID-F (atestados/afastamentos) por setor ────────
//
// Matriz da planilha "Fatores x CID F" (aba 2): para cada situação
// investigada (1:1 com a pergunta do Eixo 1), os CIDs F compatíveis. É ela
// que decide QUAIS fatores uma ocorrência relacionada ao trabalho agrava
// (×1,10). CID F é possibilidade de agravo, não diagnóstico causado pelo
// fator (aba 3, "Orientações técnicas").

model MatrizCidSituacao {
  id                String   @id @default(cuid())
  perguntaEixo1Id   String   @unique
  // Códigos normalizados: categoria ("F41") ou subcategoria ("F43.1").
  cids              String[]
  // Situação sem CID F específico ("Não específico") — nunca agrava.
  naoEspecifico     Boolean  @default(false)
  cidsDescricao     String
  consequencias     String
  observacaoTecnica String

  perguntaEixo1 Pergunta @relation(fields: [perguntaEixo1Id], references: [id], onDelete: Cascade)
}

enum StatusLevantamento {
  RASCUNHO
  PUBLICADO
}

enum RelacaoTrabalho {
  SIM
  NAO
  INCONCLUSIVO
}

// Uma publicação da planilha de ocorrências, com a identificação do
// levantamento e a declaração de veracidade do responsável (RH/DP).
model LevantamentoEixo3 {
  id                 String             @id @default(cuid())
  workspaceId        String
  nome               String
  periodoInicio      DateTime
  periodoFim         DateTime
  responsavel        String?
  cargoResponsavel   String?
  status             StatusLevantamento @default(RASCUNHO)
  // Só nome e hash do arquivo (auditoria) — o arquivo em si não é guardado:
  // dado de saúde não fica em disco público.
  arquivoNome        String?
  arquivoHash        String?
  declaracaoAceitaEm DateTime?
  declaracaoAceitaPor String?
  createdAt          DateTime           @default(now())
  publicadoEm        DateTime?

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ocorrencias OcorrenciaEixo3[]

  @@index([workspaceId])
}

// Uma linha da planilha. Nenhum identificador do trabalhador (LGPD).
model OcorrenciaEixo3 {
  id             String          @id @default(cuid())
  levantamentoId String
  // Nulo enquanto o nome da planilha não foi associado a um setor cadastrado.
  setorId        String?
  setorOriginal  String
  // Linhas de um setor que o usuário decidiu não importar.
  ignorada       Boolean         @default(false)
  linhaPlanilha  Int
  cid            String
  cidDescricao   String?
  dataInicio     DateTime?
  diasAfastados  Int?
  relacao        RelacaoTrabalho
  justificativa  String?

  levantamento LevantamentoEixo3 @relation(fields: [levantamentoId], references: [id], onDelete: Cascade)
  setor        SetorOrg?         @relation(fields: [setorId], references: [id], onDelete: SetNull)

  @@index([levantamentoId])
  @@index([setorId])
}
