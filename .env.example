# Banco
POSTGRES_USER=pesquisa
POSTGRES_PASSWORD=<gerar com: openssl rand -base64 24>
POSTGRES_DB=pesquisa
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Auth (Admin/Gestor) — colaborador não usa NextAuth (ver constitution.md §1)
AUTH_SECRET=<gerar com: openssl rand -base64 32>
AUTH_URL=http://localhost:3000

# Sessão anônima do colaborador (cookie assinado, opaco)
RESPONDENTE_COOKIE_SECRET=<gerar com: openssl rand -base64 32>

CRON_SECRET=<gerar com: openssl rand -hex 32>

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Pesquisa de Riscos Psicossociais

# SMTP (avisos ao gestor) — opcional em dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
